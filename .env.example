# ── Netlify Functions ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"test-bot-49f99","...":"..."}
FIREBASE_STORAGE_BUCKET=test-bot-49f99.firebasestorage.app

# ── Ticket email routing ─────────────────────────────────────────────
# Must be the Resend-verified SUBDOMAIN, not the root domain. The root
# mbulahenigroup.co.za MX points at Microsoft 365; repointing it would
# break the real mailbox. Use a dedicated subdomain and forward
# ITsupport@mbulahenigroup.co.za -> tickets@support.mbulahenigroup.co.za.
TICKETS_DOMAIN=support.mbulahenigroup.co.za
TICKETS_FROM_EMAIL=Cyber I.T Masters Support <ITsupport@mbulahenigroup.co.za>

# ── Optional inbound sender restrictions ─────────────────────────────
# Leave blank to accept any sender. Set comma-separated addresses/domains
# to restrict who can create tickets or reply into a thread.
ALLOWED_INBOUND_SENDERS=
ALLOWED_INBOUND_DOMAINS=

# ── Netlify runtime ──────────────────────────────────────────────────
AWS_LAMBDA_JS_RUNTIME=nodejs20.x
