# Phase 3 browser configuration. These are public client-side Firebase values;
# access control is enforced by Firebase Auth claims and security rules.
VITE_FIREBASE_ENABLED=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=522231357803
VITE_FIREBASE_APP_ID=1:522231357803:web:bf65a73d1df7269615ac2e

# Only used by the GitHub Pages workflow. Netlify/custom-domain builds use /
# by default.
VITE_BASE_PATH=/

# Server-side variables remain in Netlify and must never be prefixed VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}
FIREBASE_STORAGE_BUCKET=test-bot-49f99.firebasestorage.app
RESEND_API_KEY=
