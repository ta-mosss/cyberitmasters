{
  "name": "cyber-it-masters",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "phase1:check": "node scripts/phase1-check.mjs",
    "phase2:check": "node scripts/phase2-check.mjs",
    "phase3:check": "node scripts/phase3-check.mjs && node scripts/engineer-check.mjs && node scripts/management-check.mjs",
    "engineer:check": "node scripts/engineer-check.mjs",
    "management:check": "node scripts/management-check.mjs",
    "rules:test": "node --test tests/security/firestore.rules.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "gsap": "3.15.0",
    "ogl": "1.0.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@vitejs/plugin-react": "4.6.0",
    "vite": "7.1.2"
  },
  "engines": {
    "node": ">=20 <26",
    "npm": ">=10"
  }
