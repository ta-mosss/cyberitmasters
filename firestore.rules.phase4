// PHASE 4 TEMPLATE — REVIEW AGAINST YOUR CURRENT RULES BEFORE DEPLOYING.
// This template assumes staff users have Firebase custom claims: role.
// Customer ownership fields must be aligned with your existing Phase 1 rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(r) { return signedIn() && request.auth.token.role == r; }
    function staff() { return signedIn() && request.auth.token.role in ['super_admin','operations_manager','service_manager','dispatcher','finance','engineer']; }
    function manager() { return signedIn() && request.auth.token.role in ['super_admin','operations_manager','service_manager','dispatcher']; }
    function admin() { return signedIn() && request.auth.token.role == 'super_admin'; }

    match /tickets/{id} {
      allow read: if staff() || (signedIn() && resource.data.requesterUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid;
      allow update: if manager() || (signedIn() && resource.data.requesterUid == request.auth.uid);
    }
    match /customers/{id} {
      allow read: if staff() || (signedIn() && id == request.auth.uid);
      allow create, update: if manager() || (signedIn() && id == request.auth.uid);
    }
    match /engineers/{id} { allow read: if staff(); allow create, update: if manager(); }
    match /jobs/{id} { allow read: if staff(); allow create, update: if manager() || (role('engineer') && resource.data.assignedEngineerUid == request.auth.uid); }
    match /assets/{id} { allow read: if staff(); allow create, update: if manager() || (role('engineer') && resource.data.assignedEngineerUid == request.auth.uid); }
    match /quotes/{id} { allow read: if staff(); allow create, update: if manager() || role('finance'); }
    match /auditLogs/{id} { allow read: if manager(); allow create: if staff(); }
    match /meta/{id} { allow read: if staff(); allow write: if false; }
  }
}
