// PHASE 4 TEMPLATE — review with your current Storage rules before deployment.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function staff() { return signedIn() && request.auth.token.role in ['super_admin','operations_manager','service_manager','dispatcher','finance','engineer']; }
    match /ticket-attachments/{ticketRef}/{fileName} { allow read, write: if staff() || signedIn(); }
    match /job-attachments/{jobRef}/{fileName} { allow read, write: if staff(); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
